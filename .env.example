# Copie para `.env` e ajuste se precisar.
# Estes valores casam com o docker-compose.yml deste repositório.

# Conexão com o banco.
# Se você usar SQLAlchemy async com asyncpg, o driver na URL é postgresql+asyncpg.
DB_URL=postgresql+asyncpg://bakery:bakery@localhost:5434/bakery

# Alternativa, caso prefira montar a URL a partir das partes:
DB_HOST=localhost
DB_PORT=5434
DB_USER=bakery
DB_PASSWORD=bakery
DB_NAME=bakery

# Aplicação
APP_ENV=development
LOG_LEVEL=INFO
